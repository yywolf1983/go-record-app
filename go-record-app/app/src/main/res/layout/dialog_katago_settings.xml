<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/katago_settings_title"
        android:textSize="17sp"
        android:textStyle="bold"
        android:textColor="@color/text_primary"
        android:layout_marginBottom="12dp" />

    <!-- 模型文件（从任意目录选择，不再内置 APK） -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/katago_model"
        android:textSize="13sp"
        android:textColor="@color/text_secondary" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="2dp">

        <TextView
            android:id="@+id/tv_model_path"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="middle"
            android:singleLine="true"
            android:textSize="12sp"
            android:textColor="@color/text_primary" />

        <Button
            android:id="@+id/btn_model_select"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="@string/katago_model_select"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- 分析强度 -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/katago_strength"
        android:textSize="13sp"
        android:textColor="@color/text_secondary" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="2dp">

        <SeekBar
            android:id="@+id/seek_strength"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:min="0"
            android:max="4" />

        <TextView
            android:id="@+id/tv_strength"
            android:layout_width="64dp"
            android:layout_height="wrap_content"
            android:textAlignment="textEnd"
            android:textSize="13sp"
            android:textColor="@color/text_primary"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- 分析时间尺度（秒）：1-30，实时分析与人机对战共用 -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/katago_time_scale"
        android:textSize="13sp"
        android:textColor="@color/text_secondary"
        android:layout_marginTop="14dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="2dp">

        <SeekBar
            android:id="@+id/seek_time_scale"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:min="1"
            android:max="30" />

        <TextView
            android:id="@+id/tv_time_scale"
            android:layout_width="64dp"
            android:layout_height="wrap_content"
            android:textAlignment="textEnd"
            android:textSize="13sp"
            android:textColor="@color/text_primary"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/katago_time_scale_hint"
        android:textSize="11sp"
        android:textColor="@color/text_secondary"
        android:layout_marginTop="2dp" />

    <!-- 显示步数 -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/katago_top_n"
        android:textSize="13sp"
        android:textColor="@color/text_secondary"
        android:layout_marginTop="14dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="2dp">

        <SeekBar
            android:id="@+id/seek_topn"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:min="1"
            android:max="10" />

        <TextView
            android:id="@+id/tv_topn"
            android:layout_width="64dp"
            android:layout_height="wrap_content"
            android:textAlignment="textEnd"
            android:textSize="13sp"
            android:textColor="@color/text_primary"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- 贴目 -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/katago_komi"
        android:textSize="13sp"
        android:textColor="@color/text_secondary"
        android:layout_marginTop="14dp" />

    <Spinner
        android:id="@+id/spinner_komi"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp" />

    <!-- 线程数 -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/katago_threads"
        android:textSize="13sp"
        android:textColor="@color/text_secondary"
        android:layout_marginTop="14dp" />

    <Spinner
        android:id="@+id/spinner_threads"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp" />

    <!-- 自动分析 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="14dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/katago_auto_analyze"
            android:textSize="13sp"
            android:textColor="@color/text_secondary" />

        <Switch
            android:id="@+id/switch_auto_analyze"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />
    </LinearLayout>

    <!-- 人机对战：随时开启 / 随时任选一方（对战期间实时分析照常工作） -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/vs_settings_title"
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="@color/text_primary"
        android:layout_marginTop="18dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="8dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/vs_settings_enable"
            android:textSize="13sp"
            android:textColor="@color/text_secondary" />

        <Switch
            android:id="@+id/switch_vs_play"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/vs_settings_color"
        android:textSize="13sp"
        android:textColor="@color/text_secondary"
        android:layout_marginTop="10dp" />

    <RadioGroup
        android:id="@+id/rg_vs_color"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="2dp">

        <RadioButton
            android:id="@+id/rb_vs_black"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/vs_human_black"
            android:textSize="12sp"
            android:textColor="@color/text_primary"
            android:buttonTint="@color/colorPrimary" />

        <RadioButton
            android:id="@+id/rb_vs_white"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/vs_human_white"
            android:textSize="12sp"
            android:textColor="@color/text_primary"
            android:buttonTint="@color/colorPrimary" />
    </RadioGroup>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/vs_settings_hint"
        android:textSize="11sp"
        android:textColor="@color/text_secondary"
        android:layout_marginTop="2dp" />

    <!-- 死活模式(dynamicPlayoutDoublingAdvantageCapPerOppLead = 0.0) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginTop="14dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="死活模式"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary" />

            <Switch
                android:id="@+id/switch_tsume_mode"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="开启：dynamicPlayoutDoublingAdvantageCapPerOppLead=0.0，不随优势降搜索量，死活/官子算得更清；关闭：普通对局模式，优势时快出结果。"
            android:textSize="11sp"
            android:textColor="@color/text_secondary"
            android:layout_marginTop="2dp" />
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/katago_settings_hint"
        android:textSize="11sp"
        android:textColor="@color/text_secondary"
        android:layout_marginTop="16dp" />
</LinearLayout>
