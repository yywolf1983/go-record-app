<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/katago_settings_title"
        android:textSize="17sp"
        android:textStyle="bold"
        android:textColor="@color/text_primary"
        android:layout_marginBottom="12dp" />

    <!-- 模型文件（从任意目录选择，不再内置 APK） -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/katago_model"
        android:textSize="13sp"
        android:textColor="@color/text_secondary" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="2dp">

        <TextView
            android:id="@+id/tv_model_path"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="middle"
            android:singleLine="true"
            android:textSize="12sp"
            android:textColor="@color/text_primary" />

        <Button
            android:id="@+id/btn_model_select"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="@string/katago_model_select"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- 分析强度 -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/katago_strength"
        android:textSize="13sp"
        android:textColor="@color/text_secondary" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="2dp">

        <SeekBar
            android:id="@+id/seek_strength"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:min="0"
            android:max="4" />

        <TextView
            android:id="@+id/tv_strength"
            android:layout_width="64dp"
            android:layout_height="wrap_content"
            android:textAlignment="textEnd"
            android:textSize="13sp"
            android:textColor="@color/text_primary"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- 显示步数 -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/katago_top_n"
        android:textSize="13sp"
        android:textColor="@color/text_secondary"
        android:layout_marginTop="14dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="2dp">

        <SeekBar
            android:id="@+id/seek_topn"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:min="1"
            android:max="10" />

        <TextView
            android:id="@+id/tv_topn"
            android:layout_width="64dp"
            android:layout_height="wrap_content"
            android:textAlignment="textEnd"
            android:textSize="13sp"
            android:textColor="@color/text_primary"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- 贴目 -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/katago_komi"
        android:textSize="13sp"
        android:textColor="@color/text_secondary"
        android:layout_marginTop="14dp" />

    <Spinner
        android:id="@+id/spinner_komi"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp" />

    <!-- 线程数 -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/katago_threads"
        android:textSize="13sp"
        android:textColor="@color/text_secondary"
        android:layout_marginTop="14dp" />

    <Spinner
        android:id="@+id/spinner_threads"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp" />

    <!-- 自动分析 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="14dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/katago_auto_analyze"
            android:textSize="13sp"
            android:textColor="@color/text_secondary" />

        <Switch
            android:id="@+id/switch_auto_analyze"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/katago_settings_hint"
        android:textSize="11sp"
        android:textColor="@color/text_secondary"
        android:layout_marginTop="16dp" />
</LinearLayout>
